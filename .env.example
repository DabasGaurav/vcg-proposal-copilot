# Copy to .env and fill in only what you need. The core demo runs with NONE of these set.

# --- LLM (optional) -----------------------------------------------------------
# If unset, the pipeline uses the deterministic mock LLM (fixture-aware) so the
# demo and tests run fully offline. Set these to route through a real model.
LLM_PROVIDER=mock                 # mock | litellm
LLM_MODEL=anthropic/claude-sonnet-5   # never hardcoded in source; read from here
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# --- Embeddings (optional) --------------------------------------------------
EMBEDDINGS_BACKEND=tfidf          # tfidf | sentence-transformers
EMBEDDINGS_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Vector store (optional) ----------------------------------------------
VECTORSTORE_BACKEND=local         # local (numpy, persisted) | chroma
CHROMA_PATH=.chroma

# --- Web enrichment (secondary, optional) --------------------------------
WEB_SEARCH_PROVIDER=mock          # mock | tavily | ddg
WEB_SEARCH_ENABLED=false
# TAVILY_API_KEY=

# --- Verifier thresholds (set by Phase 0 calibration, scripts/calibrate.py) --
SEM_SUPPORTED=0.42
SEM_PARTIAL=0.22
LEX_SUPPORTED=0.18

# --- Storage --------------------------------------------------------------
DB_PATH=.data/proposal_copilot.sqlite
